===== 1. Predicción a mano (30 bytes por entrada de hoja, fo máximo de IX_PED_CLIENTE = 543) =====
entradas por hoja = floor(7996 x 0,9 / 30) = 239 -> hojas = ceil(100000/239) = 419
altura = 1 + ceil(log_543(419)) = 2
